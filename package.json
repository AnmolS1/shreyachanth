		"@types/react-dom": "^18.3.5",
		"@types/three": "^0.166.0",
		"@vitejs/plugin-react": "^6.0.5",
		"audit-ci": "^7.1.0",
		"autoprefixer": "^10.5.4",
		"concurrently": "^10.0.4",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "~7.0.2",
