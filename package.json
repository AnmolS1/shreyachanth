{
	"name": "shreyachanth",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:host": "vite --host",
		"dev:pages": "vite build && concurrently -k -n build,serve \"vite build --watch\" \"wrangler pages dev --live-reload\"",
		"typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
		"validate": "tsx src/content/validate.ts",
		"fetch:ig": "tsx scripts/fetch-ig-thumbs.ts",
		"build": "npm run validate && vite build",
		"preview": "vite preview",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@gsap/react": "^2.1.2",
		"@marsidev/react-turnstile": "^1.1.0",
		"@react-three/drei": "^9.117.3",
		"@react-three/fiber": "^8.17.8",
		"framer-motion": "^11.18.0",
		"gsap": "^3.12.7",
		"lenis": "^1.3.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-helmet-async": "^2.0.5",
		"react-router-dom": "^6.30.0",
		"three": "^0.166.0",
		"zod": "^3.24.2"
	},
	"overrides": {
		"shell-quote": "^1.8.4"
	},
	"devDependencies": {
		"@axe-core/react": "^4.13.0",
