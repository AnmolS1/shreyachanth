# ── PUBLIC (VITE_ prefix — included in client bundle) ──────────────────────────
# Safe to include in source control. These are public identifiers.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# ── SERVER-SIDE ONLY ─────────────────────────────────────────────────────────────
# NEVER prefix these with VITE_ — they must never appear in the client bundle.
# Set these in Cloudflare Pages → Settings → Environment Variables (mark Encrypted).
# For local Pages Functions dev, copy to .dev.vars (gitignored):
#   cp .env.example .dev.vars   # then fill in real values

RESEND_API_KEY=re_your_resend_api_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
BEHOLD_FEED_ID=your_behold_feed_id_here

# Optional — Sentry error monitoring
# If set, add https://*.ingest.sentry.io to CSP connect-src in public/_headers
SENTRY_DSN=https://your_sentry_dsn_here@your_org.ingest.sentry.io/your_project_id
